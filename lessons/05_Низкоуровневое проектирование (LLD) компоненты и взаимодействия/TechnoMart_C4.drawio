  <diagram id="W9bPOY5OJEXDy6qnSNkU" name="C3 — Диаграмма компонентов (внутри AI Service)">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="0" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Component\n    title C3: Диаграмма компонентов AI Service\n\n    Container(backend, \&quot;Backend\&quot;, \&quot;PHP / Bitrix\&quot;, \&quot;Вызывает API\&quot;)\n    ContainerDb(read_replica, \&quot;Read Replica\&quot;, \&quot;MySQL\&quot;, \&quot;Данные товаров\&quot;)\n    ContainerDb(vector_db, \&quot;Vector DB\&quot;, \&quot;Qdrant\&quot;, \&quot;Векторы товаров\&quot;)\n    ContainerDb(redis, \&quot;Redis Cache\&quot;, \&quot;Redis\&quot;, \&quot;Кэш\&quot;)\n    System_Ext(llm_provider, \&quot;LLM Provider\&quot;, \&quot;YandexGPT / GigaChat\&quot;, \&quot;Генерация текста\&quot;)\n\n    Container_Boundary(ai_service, \&quot;AI Service (Python / FastAPI)\&quot;) {\n        Component(controller, \&quot;Recommendation Controller\&quot;, \&quot;FastAPI\&quot;, \&quot;Валидирует HTTP-запросы\&quot;)\n        Component(orchestrator, \&quot;Recommendation Orchestrator\&quot;, \&quot;Python Class\&quot;, \&quot;Управляет потоком\&quot;)\n        \n        Component(cache_client, \&quot;Cache Client\&quot;, \&quot;Redis-py\&quot;, \&quot;Работа с кэшем\&quot;)\n        Component(data_access, \&quot;Data Access Layer\&quot;, \&quot;SQLAlchemy\&quot;, \&quot;Запросы к БД\&quot;)\n        Component(vector_client, \&quot;Vector Search Client\&quot;, \&quot;Qdrant Client\&quot;, \&quot;Работа с векторами\&quot;)\n        \n        Component(ranking_engine, \&quot;Ranking Engine\&quot;, \&quot;LightGBM\&quot;, \&quot;Сортирует кандидатов\&quot;)\n        Component(fallback_handler, \&quot;Fallback Handler\&quot;, \&quot;Python Class\&quot;, \&quot;Возвращает популярное\&quot;)\n        \n        Component(prompt_factory, \&quot;Prompt Template Factory\&quot;, \&quot;Jinja2\&quot;, \&quot;Формирует промпт\&quot;)\n        Component(llm_client, \&quot;LLM Client\&quot;, \&quot;HTTPX\&quot;, \&quot;Вызывает LLM, чистит PII\&quot;)\n        \n        Component(response_builder, \&quot;Response Builder\&quot;, \&quot;Pydantic\&quot;, \&quot;Формирует JSON\&quot;)\n    }\n\n    Rel(backend, controller, \&quot;Отправляет GET-запрос\&quot;, \&quot;REST/JSON\&quot;)\n    Rel(controller, backend, \&quot;Возвращает 200 OK\&quot;, \&quot;REST/JSON\&quot;)\n    \n    Rel(controller, orchestrator, \&quot;Передает параметры\&quot;, \&quot;In-process\&quot;)\n    \n    Rel(orchestrator, cache_client, \&quot;Проверяет кэш\&quot;, \&quot;In-process\&quot;)\n    Rel(cache_client, redis, \&quot;Читает и пишет\&quot;, \&quot;RESP\&quot;)\n    Rel(redis, cache_client, \&quot;Возвращает данные\&quot;, \&quot;RESP\&quot;)\n    \n    Rel(orchestrator, data_access, \&quot;Запрашивает текст по ID\&quot;, \&quot;In-process\&quot;)\n    Rel(data_access, read_replica, \&quot;Выполняет SQL\&quot;, \&quot;SQL\&quot;)\n    Rel(read_replica, data_access, \&quot;Возвращает текст\&quot;, \&quot;SQL\&quot;)\n    \n    Rel(orchestrator, vector_client, \&quot;Ищет кандидатов\&quot;, \&quot;In-process\&quot;)\n    Rel(vector_client, vector_db, \&quot;Ищет векторы\&quot;, \&quot;gRPC\&quot;)\n    Rel(vector_db, vector_client, \&quot;Возвращает ID\&quot;, \&quot;gRPC\&quot;)\n    \n    Rel(orchestrator, ranking_engine, \&quot;Сортирует кандидатов\&quot;, \&quot;In-process\&quot;)\n    Rel(ranking_engine, orchestrator, \&quot;Возвращает топ-10\&quot;, \&quot;In-process\&quot;)\n    \n    Rel(orchestrator, fallback_handler, \&quot;При сбое\&quot;, \&quot;In-process\&quot;)\n    \n    Rel(orchestrator, prompt_factory, \&quot;Формирует промпт\&quot;, \&quot;In-process\&quot;)\n    Rel(orchestrator, llm_client, \&quot;Отправляет промпт\&quot;, \&quot;In-process\&quot;)\n    Rel(llm_client, llm_provider, \&quot;Генерирует текст\&quot;, \&quot;REST/HTTPS\&quot;)\n    Rel(llm_provider, llm_client, \&quot;Возвращает ответ\&quot;, \&quot;REST/HTTPS\&quot;)\n    \n    Rel(orchestrator, response_builder, \&quot;Собирает ответ\&quot;, \&quot;In-process\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="8p8fO1CwHovwd2F2E68h-1">
