  <diagram id="-9ufeVEYs5Y_3P1wHx5f" name="C2 — Диаграмма контейнеров (Container Diagram">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n    title C2: Диаграмма контейнеров системы TechnoMart\n\n    Person(user, \&quot;Пользователь\&quot;, \&quot;Клиент интернет-магазина\&quot;)\n\n    System_Boundary(technomart, \&quot;TechnoMart\&quot;) {\n        Container(web, \&quot;Web Frontend\&quot;, \&quot;React / Bitrix\&quot;, \&quot;Отображает интерфейс и ленту рекомендаций\&quot;)\n        Container(backend, \&quot;Backend\&quot;, \&quot;PHP / Bitrix\&quot;, \&quot;Бизнес-логика, корзина, оформление заказов\&quot;)\n        \n        Container(ai_service, \&quot;AI Service\&quot;, \&quot;Python / FastAPI\&quot;, \&quot;Оркестрация рекомендаций, ML-инференс\&quot;)\n        \n        ContainerDb(primary_db, \&quot;Primary DB\&quot;, \&quot;MySQL\&quot;, \&quot;Транзакционные данные\&quot;)\n        ContainerDb(read_replica, \&quot;Read Replica\&quot;, \&quot;MySQL\&quot;, \&quot;Данные для чтения\&quot;)\n        ContainerDb(vector_db, \&quot;Vector DB\&quot;, \&quot;Qdrant / Milvus\&quot;, \&quot;Эмбеддинги товаров\&quot;)\n        ContainerDb(redis, \&quot;Redis Cache\&quot;, \&quot;Redis\&quot;, \&quot;Кэш рекомендаций\&quot;)\n        ContainerDb(event_pipeline, \&quot;Event Pipeline\&quot;, \&quot;Kafka / ClickHouse\&quot;, \&quot;Сбор логов кликов\&quot;)\n    }\n\n    Rel(user, web, \&quot;Открывает сайт\&quot;, \&quot;HTTPS\&quot;)\n    Rel(web, backend, \&quot;Запрашивает данные\&quot;, \&quot;HTTPS/JSON\&quot;)\n    Rel(backend, web, \&quot;Возвращает HTML/JSON\&quot;, \&quot;HTTPS\&quot;)\n    \n    Rel(backend, ai_service, \&quot;Запрашивает рекомендации\&quot;, \&quot;REST/JSON\&quot;)\n    Rel(ai_service, backend, \&quot;Возвращает список товаров\&quot;, \&quot;REST/JSON\&quot;)\n    \n    Rel(backend, primary_db, \&quot;Читает и пишет данные\&quot;, \&quot;SQL\&quot;)\n    Rel(primary_db, read_replica, \&quot;Реплицирует данные\&quot;, \&quot;MySQL Binlog\&quot;)\n    \n    Rel(ai_service, read_replica, \&quot;Запрашивает профиль и текст\&quot;, \&quot;SQL\&quot;)\n    Rel(read_replica, ai_service, \&quot;Возвращает данные\&quot;, \&quot;SQL\&quot;)\n    \n    Rel(ai_service, vector_db, \&quot;Ищет похожие векторы\&quot;, \&quot;gRPC\&quot;)\n    Rel(vector_db, ai_service, \&quot;Возвращает ID и скоры\&quot;, \&quot;gRPC\&quot;)\n    \n    Rel(ai_service, redis, \&quot;Читает и пишет кэш\&quot;, \&quot;RESP\&quot;)\n    Rel(redis, ai_service, \&quot;Возвращает кэш\&quot;, \&quot;RESP\&quot;)\n    \n    Rel(web, event_pipeline, \&quot;Отправляет события кликов\&quot;, \&quot;HTTP\&quot;)\n    Rel(backend, event_pipeline, \&quot;Отправляет события покупок\&quot;, \&quot;Kafka\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="u2AgwKPq7B8ObiKByFaC-1">
